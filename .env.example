NODE_ENV=development
PORT=4000
LOG_LEVEL=info
API_PREFIX=/api/v1
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SWAGGER_ENABLED=true
# Generate a strong secret for production, e.g. `openssl rand -hex 32` (min 32 chars)
JWT_SECRET=local-dev-secret-min-32-chars-required!!
JWT_EXPIRES_IN=1d
# Mobile-driver authentication is isolated from admin authentication.
MOBILE_JWT_SECRET=local-mobile-secret-min-32-chars-required!
MOBILE_DEVICE_PEPPER=local-device-pepper-min-32-chars-required!
MOBILE_ACCESS_TOKEN_EXPIRES_IN=10m
MOBILE_REFRESH_TOKEN_DAYS=30
MOBILE_SESSION_ABSOLUTE_DAYS=90
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional: direct URL for migrations (non-pooler) when using Neon or similar
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SARVAM_API_KEY=

# Optional: ticket notification emails (in-app notifications work without SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=notifications@example.com
# APP_PUBLIC_URL=https://app.example.com

# Cloudflare R2 storage for announcement audio uploads (optional until uploads are used)
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=announcement-audio
# R2_PUBLIC_BASE_URL=https://audio.example.com
AUDIO_MAX_SIZE_BYTES=52428800
