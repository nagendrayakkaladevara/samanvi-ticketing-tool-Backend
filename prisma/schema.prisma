generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  admin
  supervisor
  worker
}

enum TicketStatus {
  created
  assigned
  in_progress
  blocked
  resolved
  closed
  reopened
}

enum TicketSeverity {
  critical
  high
  medium
  low
}

enum TicketPriority {
  p1
  p2
  p3
}

enum TicketActivityType {
  created
  assigned
  status_changed
  commented
  reopened
  closed
}

enum NotificationType {
  ticket_created
  ticket_assigned
  ticket_status_changed
  ticket_commented
  ticket_reopened
  ticket_closed
}

enum RepairJobStatus {
  created
  assigned
  in_progress
  on_hold
  completed
  cancelled
}

enum RepairJobPriority {
  low
  medium
  high
  urgent
}

model Role {
  id        String    @id @default(cuid())
  code      RoleCode  @unique
  label     String    @db.VarChar(50)
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id                 String                @id @default(cuid())
  username           String                @unique @db.VarChar(50)
  passwordHash       String                @db.VarChar(255)
  displayName        String                @db.VarChar(100)
  email              String?               @unique @db.VarChar(150)
  isActive           Boolean               @default(true)
  roleId             String
  role               Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdTickets     Ticket[]              @relation("TicketCreatedBy")
  assignedTickets    Ticket[]              @relation("TicketAssignedTo")
  assignmentActions  Ticket[]              @relation("TicketAssignedBy")
  activityLogs       TicketActivityLog[]
  notifications      Notification[]
  createdRepairJobs  RepairJob[]           @relation("RepairJobCreatedBy")
  repairJobParts     RepairJobPart[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model ServiceFor {
  id              String          @id @default(cuid())
  serviceFor      String          @unique @db.VarChar(120)
  serviceNumbers  ServiceNumber[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Bus {
  id                        String      @id @default(cuid())
  busNumber                 String      @unique @db.VarChar(50)
  engineNumber              String      @db.VarChar(80)
  chassisNumber             String      @db.VarChar(80)
  purchaseDate              DateTime?
  odometer                  Int
  insuranceValidity         DateTime
  pollutionValidity         DateTime?
  fcValidity                DateTime?
  basePermitValidity        DateTime?
  homeTaxValidity           DateTime?
  aitpValidity              DateTime?
  aitpAuthorizationValidity DateTime?
  serviceOutDate            DateTime?
  remarks                   String?     @db.VarChar(500)
  lastMaintenanceDate       DateTime?
  tickets                   Ticket[]
  repairJobs                RepairJob[]
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
}

model SpareTank {
  id        String   @id @default(cuid())
  busNumber String   @db.VarChar(50)
  ownerName String   @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([busNumber])
}

model ServiceNumber {
  id              String     @id @default(cuid())
  serviceForId    String
  serviceFor      ServiceFor @relation(fields: [serviceForId], references: [id], onDelete: Restrict)
  serviceNo       String     @unique @db.VarChar(50)
  from            String     @db.VarChar(120)
  to              String     @db.VarChar(120)
  via             String     @db.VarChar(120)
  parkingAmount   Decimal    @db.Decimal(12, 2)
  driverOneBeta   Decimal    @db.Decimal(12, 2)
  driverTwoBeta   Decimal    @db.Decimal(12, 2)
  helperBeta      Decimal    @db.Decimal(12, 2)
  conductorBeta   Decimal    @db.Decimal(12, 2)
  distance        Decimal    @db.Decimal(12, 2)
  optDriver       String     @db.VarChar(120)
  optHelper       String     @db.VarChar(120)
  remarks         String     @db.VarChar(500)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([serviceForId])
}

model Driver {
  id                   String    @id @default(cuid())
  driverIdNumber       String    @unique @db.VarChar(10)
  aadharName           String    @db.VarChar(120)
  dlName               String    @db.VarChar(120)
  dateOfBirth          DateTime
  mobileNumber         String    @db.VarChar(10)
  alternateMobile      String?   @db.VarChar(10)
  emergencyNumber      String?   @db.VarChar(10)
  aadharNumber         String    @unique @db.VarChar(12)
  dlNumber             String    @unique @db.VarChar(30)
  accountHolderName    String    @db.VarChar(120)
  accountNumber        String    @db.VarChar(30)
  bankName             String    @db.VarChar(120)
  branchName           String    @db.VarChar(120)
  ifscCode             String    @db.VarChar(11)
  upiId                String?   @db.VarChar(120)
  dlIssueDate          DateTime
  dlExpiryDate         DateTime
  transportIssueDate   DateTime
  transportValidFrom   DateTime
  transportValidTo     DateTime
  dateOfJoining        DateTime
  dateOfLeaving        DateTime?
  referenceName        String    @db.VarChar(120)
  remarks              String?   @db.VarChar(500)
  aadharCardFront      Bytes
  aadharCardBack       Bytes
  dlFront              Bytes
  dlBack               Bytes
  upiScanner           Bytes?
  reportedRepairJobs   RepairJob[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Helper {
  id                String    @id @default(cuid())
  helperIdNumber    String    @unique @db.VarChar(10)
  nickName          String    @db.VarChar(120)
  aadharName        String    @db.VarChar(120)
  mobileNumber      String    @db.VarChar(10)
  alternateNumber   String?   @db.VarChar(10)
  emergencyMobile   String?   @db.VarChar(10)
  aadharNumber      String    @unique @db.VarChar(12)
  reference         String    @db.VarChar(120)
  accountHolderName String    @db.VarChar(120)
  accountNumber     String    @db.VarChar(30)
  bankName          String    @db.VarChar(120)
  branchName        String    @db.VarChar(120)
  ifscCode          String    @db.VarChar(11)
  upiId             String?   @db.VarChar(120)
  dateOfJoining     DateTime
  dateOfLeaving     DateTime?
  remarks           String?   @db.VarChar(500)
  aadharCardFront   Bytes
  aadharCardBack    Bytes
  upiScanner        Bytes?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model OfficeStaff {
  id                String    @id @default(cuid())
  staffIdNumber     String    @unique @db.VarChar(10)
  designation       String    @db.VarChar(120)
  nickName          String    @db.VarChar(120)
  aadharName        String    @db.VarChar(120)
  mobileNumber      String    @db.VarChar(10)
  alternativeMobile String?   @db.VarChar(10)
  emergencyContact  String?   @db.VarChar(10)
  aadharNumber      String    @unique @db.VarChar(12)
  referenceName     String    @db.VarChar(120)
  accountHolderName String    @db.VarChar(120)
  accountNumber     String    @db.VarChar(30)
  bankName          String    @db.VarChar(120)
  branchName        String    @db.VarChar(120)
  ifscCode          String    @db.VarChar(11)
  upiId             String?   @db.VarChar(120)
  dateOfJoining     DateTime
  dateOfLeaving     DateTime?
  remarks           String?   @db.VarChar(500)
  aadharCardFront   Bytes
  aadharCardBack    Bytes
  upiScanner        Bytes?
  assignedRepairJobs RepairJob[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model IssueCategory {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(80)
  isActive  Boolean  @default(true)
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id             String        @id @default(cuid())
  ticketNumber   Int           @unique
  title          String        @db.VarChar(160)
  description    String
  status         TicketStatus  @default(created)
  severity       TicketSeverity
  priority       TicketPriority
  busId          String
  bus            Bus           @relation(fields: [busId], references: [id], onDelete: Restrict)
  categoryId     String
  category       IssueCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User          @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedToId   String?
  assignedTo     User?         @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedById   String?
  assignedBy     User?         @relation("TicketAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  slaDueAt       DateTime
  /** Milliseconds from ticket creation to original SLA deadline; fixed at create for correct reopen SLA. */
  slaDurationMs  BigInt       @default(0)
  resolvedAt     DateTime?
  closedAt       DateTime?
  reopenedCount  Int           @default(0)
  activityLogs   TicketActivityLog[]
  notifications  Notification[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([slaDueAt])
  @@index([busId])
}

model TicketActivityLog {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actionType  TicketActivityType
  fromStatus  TicketStatus?
  toStatus    TicketStatus?
  note            String?
  createdAt       DateTime           @default(now())
  notifications   Notification[]

  @@index([ticketId, createdAt])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String           @db.VarChar(200)
  message        String           @db.VarChar(500)
  ticketId       String
  ticket         Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  activityLogId  String?
  activityLog    TicketActivityLog? @relation(fields: [activityLogId], references: [id], onDelete: SetNull)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([ticketId])
}

model RepairCategory {
  id         String           @id @default(cuid())
  name       String           @db.VarChar(120)
  parentId   String?
  parent     RepairCategory?  @relation("RepairCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   RepairCategory[] @relation("RepairCategoryHierarchy")
  level      Int
  repairJobs RepairJob[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
}

model RepairPart {
  id          String          @id @default(cuid())
  partName    String          @unique @db.VarChar(120)
  price       Decimal         @db.Decimal(12, 2)
  description String?         @db.VarChar(500)
  jobParts    RepairJobPart[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model RepairJob {
  id                 String            @id @default(cuid())
  jobIdNumber        String            @unique @db.VarChar(10)
  busId              String
  bus                Bus               @relation(fields: [busId], references: [id], onDelete: Restrict)
  odometerReading    Int
  repairCategoryId   String
  repairCategory     RepairCategory    @relation(fields: [repairCategoryId], references: [id], onDelete: Restrict)
  priority           RepairJobPriority
  reportedDriverId         String?
  reportedDriver           Driver?      @relation(fields: [reportedDriverId], references: [id], onDelete: SetNull)
  assignedToOfficeStaffId  String?
  assignedToOfficeStaff    OfficeStaff? @relation(fields: [assignedToOfficeStaffId], references: [id], onDelete: SetNull)
  description              String
  status             RepairJobStatus   @default(created)
  createdById        String
  createdBy          User              @relation("RepairJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  isRepeatJob        Boolean           @default(false)
  previousJobId      String?
  previousJob        RepairJob?        @relation("RepairJobRepeatChain", fields: [previousJobId], references: [id], onDelete: SetNull)
  repeatChildren     RepairJob[]       @relation("RepairJobRepeatChain")
  repeatScheduledFor DateTime?
  repeatProcessedAt  DateTime?
  deletedAt          DateTime?
  parts              RepairJobPart[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([assignedToOfficeStaffId])
  @@index([status])
  @@index([deletedAt])
  @@index([repeatScheduledFor])
  @@index([busId])
}

model RepairJobPart {
  id           String     @id @default(cuid())
  repairJobId  String
  repairJob    RepairJob  @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  repairPartId String
  repairPart   RepairPart @relation(fields: [repairPartId], references: [id], onDelete: Restrict)
  quantity     Int        @default(1)
  unitPrice    Decimal    @db.Decimal(12, 2)
  addedById    String
  addedBy      User       @relation(fields: [addedById], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@index([repairJobId])
}
